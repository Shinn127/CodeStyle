# NewCode standalone repository.
#
# Versioned: code, tests, docs, and the full text evidence trail (analysis reports,
# training/eval logs, diagnostic/eval JSON, per-sample eval CSVs, validation records).
# NOT versioned: large generated payloads that stay on disk - model weights, datasets,
# caches, derived numeric blobs (*.npz/*.npy/*.f32), profiler traces and media
# (videos/gifs). They are regeneratable or too large for git.

# -----------------------------------------------------------------------------
# OS / editor
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# Python caches / envs
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# -----------------------------------------------------------------------------
# Model weights, datasets, derived numeric payloads (large binaries stay local)
# -----------------------------------------------------------------------------
/checkpoints/
/cache/
/database_100sty_375_memmap*/
/data/
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.npz
*.npy
*.f32
*.i32
*.u16
*.bin

# Exception: tiny per-run normalization metadata (~3 KB) needed to interpret eval_results.
!eval_results/**/*.npz

# -----------------------------------------------------------------------------
# Media and profiler traces (large; keep generated media on disk)
# -----------------------------------------------------------------------------
rollout_vis/
reconstruction_vis/
*.trace.json
*.mp4
*.mov
*.avi
*.gif

# -----------------------------------------------------------------------------
# Runtime scratch (keep nohup auto-output out; real *.log files ARE versioned)
# -----------------------------------------------------------------------------
nohup.out
